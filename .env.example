# Copy values into apps/api/.env and apps/web/.env.local.
# Never commit real connection strings, JWT secrets, or API keys.

# API — Postgres (Neon Free or local Docker)
# DATABASE_URL must be the pooled Neon URL for runtime traffic.
# DIRECT_URL is used by Prisma CLI commands only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/taskflow
USE_IN_MEMORY=true
PORT=3001
JWT_SECRET=replace-with-a-long-random-value
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Optional API tuning (defaults shown)
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Web — backend-for-frontend routes call the API server-side.
# API_URL is required; NEXT_PUBLIC_API_URL is a fallback for compatibility.
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional integration keys (not required for the free demo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@taskflow.dev
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
